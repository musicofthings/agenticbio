# Agentic Bio Classroom — local ClassroomIO stack
# Copy to .env, then run: ./scripts/gen-secrets.sh
#
# Official env names from ClassroomIO. Do not use PUBLIC_API_URL /
# PUBLIC_DASHBOARD_URL / BETTER_AUTH_URL — those are not read by this LMS.

# ──────────────────────────────────────────────
# Image version (Docker Hub classroomio/{api,dashboard,jobs})
# ──────────────────────────────────────────────
# Pin an immutable release. 1.0.0 is the current v1 tag (amd64 + arm64).
# "latest" moves on every merge to ClassroomIO main — do not use for a stable local instance.
CIO_VERSION=1.0.0

# ──────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────

POSTGRES_DB=classroomio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Auth secret for session signing. REQUIRED — compose refuses to start if empty.
# Generated by ./scripts/gen-secrets.sh
BETTER_AUTH_SECRET=

# Dashboard-to-API auth key. Must be the same value in both API and dashboard.
# Generated by ./scripts/gen-secrets.sh
PRIVATE_SERVER_KEY=

# Published dashboard images are built with PUBLIC_IS_SELFHOSTED=true.
PUBLIC_IS_SELFHOSTED=true

# Dashboard SSR calls the API on the Docker network (never a public hostname).
PRIVATE_SERVER_URL=http://api:3081

# SvelteKit CSRF + invite/email links. Local first.
# Production (Cloudflare): https://learn.agenticbio.in  (domain: agenticbio.in)
DASHBOARD_ORIGIN=http://localhost:3082

# Optional direct API origin. Normal dashboard traffic is proxied same-origin.
PUBLIC_SERVER_URL=http://localhost:3081

# Comma-separated extra origins if a browser calls the API directly.
TRUSTED_ORIGINS=

ALLOWED_EXTERNAL_DOMAINS=

# ──────────────────────────────────────────────
# Branding (runtime, if the dashboard image reads these)
# ──────────────────────────────────────────────
PUBLIC_APP_TITLE=Agentic Bio Classroom
PUBLIC_APP_DESCRIPTION=The Agentic Bio Fellowship — privacy-first local AI orchestration for life sciences
# PUBLIC_OG_IMAGE_URL=

# Dashboard domain routing (local)
PRIVATE_APP_HOST=localhost
PRIVATE_APP_SUBDOMAINS=app

# ──────────────────────────────────────────────
# Email — Mailpit on the local compose override (http://localhost:8025)
# Production: replace with Resend / Postmark / Zoho. Cloudflare Access OTP
# does not send ClassroomIO verification, invite, or password-reset mail.
# ──────────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=mailpit
SMTP_PASSWORD=mailpit
SMTP_SENDER=noreply@agenticbio.local
# Production: noreply@agenticbio.in (after SPF/DKIM on the Cloudflare zone)

# ──────────────────────────────────────────────
# Object storage (bundled MinIO)
# ──────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=http://localhost:9000/media
OBJECT_STORAGE_BUCKET_VIDEOS=videos
OBJECT_STORAGE_BUCKET_DOCUMENTS=documents
OBJECT_STORAGE_BUCKET_MEDIA=media

# ──────────────────────────────────────────────
# Optional integrations
# ──────────────────────────────────────────────
# Google OAuth (optional). Leave empty to use email/password only.
# Dummy IDs like docker-local-client-id cause Google Error 401: invalid_client.
# Local callback (Better Auth, self-hosted): http://localhost:3082/api/auth/callback/google
# Production later: https://learn.agenticbio.in/api/auth/callback/google
# Origins: http://localhost:3082  and later https://learn.agenticbio.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UNSPLASH_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Enterprise ClassroomIO features (SSO, token-auth, no-tracking)
LICENSE_KEY=

# Upload limits (MB). Unset = ClassroomIO defaults.
# UPLOAD_MAX_DOCUMENT_MB=5
# UPLOAD_MAX_IMAGE_MB=5
# UPLOAD_MAX_VIDEO_MB=800
# UPLOAD_MAX_EXERCISE_FILE_MB=2
# UPLOAD_MAX_AGENT_DOCUMENT_MB=5
# UPLOAD_MAX_LANDING_IMAGE_MB=0.5
# UPLOAD_MAX_THUMBNAIL_MB=5

# Skip automatic schema setup on api start (only if you run migrations out of band)
# SKIP_DB_SETUP=true

# Optional. Created automatically by ./scripts/seed_cohort1.py if missing.
# Do not commit the real value. Used only to import curriculum via /public-api/v1.
# CLASSROOMIO_API_KEY=
