# Production env for learn.agenticbio.in
# Copy to .env.production (never commit) and fill secrets.
#
#   cp .env.production.example .env.production
#   ./scripts/gen-secrets.sh .env.production
#   ./scripts/prod-up.sh

CIO_VERSION=1.0.0
# Pin cloudflared (docker-compose.prod.yml). Do not use :latest on a live LMS.
CLOUDFLARED_VERSION=2026.8.2

POSTGRES_DB=classroomio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

BETTER_AUTH_SECRET=
PRIVATE_SERVER_KEY=

PUBLIC_IS_SELFHOSTED=true
PRIVATE_SERVER_URL=http://api:3081

DASHBOARD_ORIGIN=https://learn.agenticbio.in
PUBLIC_SERVER_URL=https://learn.agenticbio.in
TRUSTED_ORIGINS=https://learn.agenticbio.in

PUBLIC_APP_TITLE=Agentic Bio Classroom
PUBLIC_APP_DESCRIPTION=The Agentic Bio Fellowship — privacy-first local AI orchestration for life sciences

PRIVATE_APP_HOST=learn.agenticbio.in
PRIVATE_APP_SUBDOMAINS=app

# Real SMTP. Mailpit is local-only. Cloudflare Access OTP is not this mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=noreply@agenticbio.in

# MinIO stays on the Docker network. Public media URL must be HTTPS on the LMS host
# (Cloudflare path /media -> minio:9000) or switch these to R2.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://learn.agenticbio.in
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=https://learn.agenticbio.in/media
OBJECT_STORAGE_BUCKET_VIDEOS=videos
OBJECT_STORAGE_BUCKET_DOCUMENTS=documents
OBJECT_STORAGE_BUCKET_MEDIA=media

# Cloudflare Tunnel token from Zero Trust → Networks → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional. Empty = email/password only. See docs/GOOGLE_OAUTH.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

UNSPLASH_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
LICENSE_KEY=
